{
  "name": "local-message-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node node_modules/typescript/lib/tsc.js --noEmit && node node_modules/vite/bin/vite.js build && node scripts/generate-service-worker.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
